#include <winres.h>
#include "weq/Version.h"

1 ICON "@ICON_PATH@"
100 RCDATA "@PAYLOAD_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WEQ_VERSION_MAJOR,WEQ_VERSION_MINOR,WEQ_VERSION_PATCH,0
 PRODUCTVERSION WEQ_VERSION_MAJOR,WEQ_VERSION_MINOR,WEQ_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", WEQ_PUBLISHER
            VALUE "FileDescription", "Windows EQ Setup"
            VALUE "FileVersion", WEQ_VERSION_STR
            VALUE "InternalName", "WindowsEQ-Setup"
            VALUE "OriginalFilename", "WindowsEQ-Setup.exe"
            VALUE "ProductName", "Windows EQ"
            VALUE "ProductVersion", WEQ_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
